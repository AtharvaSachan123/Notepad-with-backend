<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit - Notepad</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>
</head>
<body>
    <div class="main primary-text w-full min-h-screen main-bg p-4">
        <div class="flex justify-between items-center mb-10">
            <a class="text-blue-500 inline-block hover:text-blue-400" href="/">Go back to home</a>
            <button id="theme-toggle" class="secondary-bg primary-text px-4 py-2 rounded-md hover:opacity-80 transition-opacity">
                ☀️ Light Mode
            </button>
        </div>

        <form action="/edit" method="post">
            <input class="block rounded-md outline-none w-1/4 secondary-text px-5 py-2 secondary-bg" type="text" placeholder="Previous Name" name="previous" value="<%= filename %>">
            <input class="block rounded-md outline-none w-1/4 px-5 mt-2 py-2 secondary-bg primary-text resize-none" placeholder="New Name" name="new">
            <input class="mt-2 bg-yellow-600 text-white px-5 py-2 rounded-md cursor-pointer hover:bg-yellow-700 transition-colors" type="submit" value="Update Name">
        </form>
    </div>
</body>
</html>
