<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notepad</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>
</head>
<body>
    <div class="main w-full min-h-screen main-bg">
        <div class="flex justify-end p-4">
            <button id="theme-toggle" class="secondary-bg primary-text px-4 py-2 rounded-md hover:opacity-80 transition-opacity">
                ☀️ Light Mode
            </button>
        </div>
        <div class="form px-10 pb-10 primary-text">
            <form action="/create" method="post">
                <input class="block rounded-md outline-none w-full px-5 py-2 secondary-bg primary-text" type="text" placeholder="Title goes here" name="title">
                <textarea class="block rounded-md outline-none w-full px-5 mt-2 py-2 secondary-bg primary-text resize-none" placeholder="Description goes here" name="details"></textarea>
                <input class="mt-2 bg-blue-600 text-white px-5 py-2 rounded-md cursor-pointer hover:bg-blue-700 transition-colors" type="submit" value="Create task">
            </form>
        </div>
        <div class="tasks px-10 pb-10 flex gap-4 flex-wrap">
            <% if (files.length > 0) { %>
                <% files.forEach(function(val) { %>
                    <div class="task min-w-72 px-3 py-4 secondary-bg rounded-md">
                        <h1 class="primary-text text-3xl tracking-tighter"><%= val %></h1>
                        <div class="flex w-full justify-between items-center mt-3">
                            <a class="text-blue-500 inline-block hover:text-blue-400" href="/files/<%= val %>">Read more</a>
                            <a class="text-red-500 inline-block hover:text-red-400" href="/edit/<%= val %>">Edit Filename</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="primary-text tertiary-bg p-4 rounded-md">No tasks yet</h3>
            <% } %>
        </div>
    </div>
</body>
</html>
